ENV=development
APP_VERSION=0.1.0
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/deep_dig
REDIS_URL=redis://localhost:6379/0
AUTH_SECRET=change-me
LOCAL_AUTH_USERNAME=admin
LOCAL_AUTH_PASSWORD=change-me
LOCAL_AUTH_USER_ID=00000000-0000-0000-0000-000000000001
LOCAL_AUTH_EMAIL=admin@deepdig.local
PARSED_CACHE_DIR=./parsed_cache
UPLOAD_MAX_BYTES=50000000
LLM_PROVIDER=auto
LLM_OPENROUTER_KEY=replace-me
LLM_ANTHROPIC_KEY=replace-me
LLM_COMPAT_BASE_URL=https://api.openai.com/v1
LLM_COMPAT_API_KEY=replace-me
LLM_COMPAT_MODEL=gpt-4o-mini
DAILY_COST_BUDGET_USD=200
FREE_MONTHLY_QUOTA=50
FREE_BATCH_LIMIT=10
FREE_CONCURRENT_JOBS=1
MAX_TEXT_CHARS=200000
JOB_SUBMIT_USER_LIMIT_PER_MINUTE=5
JOB_SUBMIT_IP_LIMIT_PER_MINUTE=20
JOB_READ_USER_LIMIT_PER_MINUTE=90
JOB_READ_IP_LIMIT_PER_MINUTE=240
JOB_ACTION_USER_LIMIT_PER_MINUTE=10
JOB_ACTION_IP_LIMIT_PER_MINUTE=40
SENTRY_DSN=
WORKER_MAX_JOBS=8
ITEM_JOB_TIMEOUT_SECONDS=600
ITEM_MAX_TRIES=3
ITEM_RETRY_BASE_SECONDS=2
ITEM_QUEUE_EXPIRY_SECONDS=604800
