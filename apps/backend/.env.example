# Required application services
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/deep_dig
REDIS_URL=redis://localhost:6379/0

# Authentication. Accounts are created from the web UI. Keep AUTH_SECRET stable:
# it signs login tokens and encrypts saved API keys.
AUTH_SECRET=replace-with-a-long-random-secret

# LLM settings may instead be entered in the frontend Settings page.
# These OpenAI-compatible settings support OpenAI, DeepSeek, local gateways,
# and other services that expose the same API shape.
LLM_COMPAT_BASE_URL=https://api.openai.com/v1
LLM_COMPAT_API_KEY=
LLM_COMPAT_MODEL=gpt-4o-mini
