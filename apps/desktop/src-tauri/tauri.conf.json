{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deep Dig",
  "version": "0.1.0",
  "identifier": "ai.deepdig.desktop",
  "build": {
    "beforeDevCommand": "pnpm build:sidecar && pnpm dev",
    "beforeBuildCommand": "pnpm build:sidecar && pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Deep Dig",
        "width": 1100,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/deep-dig-parser"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
