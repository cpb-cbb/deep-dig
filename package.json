{
  "name": "deep-dig",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:start": "scripts/deep-dig-dev.sh start",
    "dev:stop": "scripts/deep-dig-dev.sh stop",
    "dev:restart": "scripts/deep-dig-dev.sh restart",
    "dev:status": "scripts/deep-dig-dev.sh status",
    "dev:desktop": "pnpm --filter @deep-dig/desktop dev",
    "build:desktop": "pnpm --filter @deep-dig/desktop build",
    "check:backend": "cd apps/backend && uv run ruff format --check app tests && uv run ruff check app tests && uv run pytest",
    "check:desktop": "pnpm --filter @deep-dig/desktop build",
    "check": "pnpm check:backend && pnpm check:desktop",
    "generate:api": "cd apps/backend && uv run python -m app.scripts.export_openapi && cd ../.. && pnpm generate:types",
    "generate:types": "openapi-typescript apps/backend/openapi.json -o packages/shared-types/src/openapi.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.1"
  }
}
